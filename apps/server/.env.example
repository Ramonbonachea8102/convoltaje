# ============================================================
# CONVOLTAJE APPS SERVER — PLANTILLA DE VARIABLES DE ENTORNO
# (Configurar valores reales en el panel de Railway / .env local)
# ============================================================

PORT=8080
NODE_ENV=production

# Supabase (Configuración exclusiva de backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Meta / WhatsApp Cloud API & AgentKit
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_sha256
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Seguridad y CORS (Orígenes separados por coma)
ALLOWED_ORIGINS=https://convoltaje.com,https://admin.convoltaje.com,http://localhost:5173
